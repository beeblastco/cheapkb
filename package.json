{
  "name": "cheapkb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "web:build": "API_URL=https://example.execute-api.us-east-1.amazonaws.com/v1 VITE_POSTHOG_KEY=phc_ci VITE_POSTHOG_HOST=https://eu.i.posthog.com npm --prefix web run build",
    "bundle:check": "node scripts/bundle-budget.ts --check",
    "bundle:record": "node scripts/bundle-budget.ts --record",
    "perf:check": "node scripts/web-perf-check.ts --check",
    "perf:record": "node scripts/web-perf-check.ts --record",
    "check": "npm run lint && npm run knip && npm run format:check && npm run build && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-s3vectors": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@pulumi/aws": "7.20.0",
    "@pulumi/pulumi": "^3.272.0",
    "gpt-tokenizer": "^4.1.0",
    "jose": "^6.2.13",
    "sst": "^4.17.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@oxlint/plugins": "1.89.0",
    "@shadcn/lint": "^0.2.3",
    "@smithy/types": "4.19.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "aws-sdk-client-mock": "^4.1.0",
    "jsdom": "^30.1.3",
    "knip": "6.44.1",
    "oxlint": "^1.89.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0"
  }
}
