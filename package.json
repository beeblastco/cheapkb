{
  "name": "cheapkb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "bundle:check": "node scripts/bundle-budget.ts --check",
    "bundle:record": "node scripts/bundle-budget.ts --record",
    "check": "npm run lint && npm run format:check && npm run build && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
    "@aws-sdk/client-lambda": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-s3vectors": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@aws-sdk/lib-dynamodb": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@pulumi/aws": "7.20.0",
    "@pulumi/pulumi": "^3.267.0",
    "gpt-tokenizer": "^4.0.0",
    "jose": "^6.2.12",
    "sst": "^4.17.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jsdom": "^30.0.0",
