# Amazon Bedrock Cohere Embed v4 configuration
BEDROCK_EMBEDDING_MODEL=us.cohere.embed-v4:0
# Optional cross-account role used only by the Pipeline and Query Lambdas
BEDROCK_ASSUME_ROLE_ARN=
BEDROCK_ASSUME_ROLE_EXTERNAL_ID=

# Chunking configuration
# Maximum number of tokens per chunk (default: 700)
CHUNK_MAX_TOKENS=700
# Number of overlapping tokens between adjacent chunks (default: 100)
CHUNK_OVERLAP_TOKENS=100
# Maximum PDF/text upload in bytes (default: 10 MiB)
MAX_UPLOAD_BYTES=10485760
# Maximum image upload in bytes (default: 5 MiB)
MAX_IMAGE_UPLOAD_BYTES=5242880
# Maximum chunks generated for one document (default: 200)
MAX_CHUNKS_PER_DOCUMENT=200

# Optional: Batch sizes for vectorization and embedding
# VECTOR_BATCH: Number of vectors to process in a single batch (default: 500)
VECTOR_BATCH=500
# EMBED_BATCH: Maximum SQS items packed into Cohere requests (default: 10)
EMBED_BATCH=10

# Cohere Embed v4 on-demand input rate; review when AWS pricing changes.
EMBEDDING_INPUT_PRICE_PER_1M_TOKENS=0.12

# App origin for shoo.dev JWT audience verification
APP_ORIGIN=http://localhost:5173

# Optional: pin deploys to one AWS account. When set, sst.config.ts refuses to
# deploy anywhere else. Leave unset to deploy to whatever your credentials resolve.
AWS_ACCOUNT_ID=
